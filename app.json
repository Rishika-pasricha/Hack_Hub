{
  "expo": {
    "name": "Ecofy",
    "slug": "Ecofy",
    "scheme": "ecofy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ecofy.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.ecofy.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Ecofy to use your camera for live waste segregation."
        }
      ]
    ],
    "extra": {
      "router": {},
      "publicApiBaseUrl": "https://hack-hub-0bok.onrender.com",
      "eas": {
        "projectId": "e61943f0-8c1a-41f1-8a12-f21de4bf346e"
      }
    }
  }
}
